FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
# Explicit copies exclude the developer's .env, build output and credentials.
COPY src ./src
COPY public ./public
COPY next.config.mjs next-env.d.ts tsconfig.json .eslintrc.cjs ./
ENV NEXT_PUBLIC_API_BASE_PATH=/api/
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0"]
