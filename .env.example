# The only operator-managed application env file: copy to .env, chmod 600.
# These credentials are FOR LOCAL DEVELOPMENT ONLY. Production instructions:
# docs/deployment.md (retain your existing project name and DB credentials).
COMPOSE_PROJECT_NAME=nycu-archery-system
ARCHERY_ENVIRONMENT=development
ARCHERY_SITE_ADDRESS=http://127.0.0.1
ARCHERY_ACME_EMAIL=

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=testdb
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password

ARCHERY_SESSION_KEY='local-development-session-key-change-in-production'
ARCHERY_DICTATOR_USERNAME=dictator
ARCHERY_DICTATOR_PASSWORD=password
ARCHERY_DICTATOR_EMAIL=admin@example.test
ARCHERY_DICTATOR_OVERVIEW=

# Public BUILD-TIME setting. Relative path keeps HTTP/HTTPS same-origin.
NEXT_PUBLIC_API_BASE_PATH=/api/
